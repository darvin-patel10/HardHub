<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products - JOY Hardware Solutions</title>
    <link rel="stylesheet" href="/css/customer/navbar.css">
    <link rel="stylesheet" href="/css/customer/product.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>
    <header>
        <h1>JOY Hardware Products</h1>
        <p>Quality tools for professionals and DIY enthusiasts</p>
    </header>

    <%- include('partials/navbar') %>


    <section class="product-categories">
        <h2 style="text-align: center;">Product Categories</h2>
        <div class="category-buttons">
            <button onclick="filterProducts('all')">All Products</button>
            <%
                let allCategories = new Set();
                allproducts.forEach(product => {
                    if (product.category) {
                        allCategories.add(product.category);
                    }
                });
                allCategories.forEach(category => {
            %>
                <button onclick='filterProducts(<%- JSON.stringify(category) %>)'><%= category %></button>
            <% }); %>
        </div>
    </section>

    <section class="products-container" id="products">
        <!-- Aldrop -->
         <% for (let product of allproducts) {%>
        <div class="product-card" data-category="<%=product.category%>">
            <a href="/buyer/product-details/<%=product.productid%>">
                <img src="<%= product.image?.[0]?.url || '/image/placeholder-product.svg' %>" alt="<%=product.name%>" onerror="this.onerror=null;this.src='/image/placeholder-product.svg';">
                <div class="product-name"><%=product.name%></div>
                <div class="price"><%=product.price%></div>
                <p><%=product.small_description%> </p>
            </a>
        </div>
        <%}%>
    </section>

    <footer>
        <p>&copy; 2023 JOY Hardware Solutions. All Rights Reserved.</p>
        <p>Contact: sales@joyhardware.com | Phone: +91 7201956899</p>
    </footer>

    <script src="/script/customer/product.js"></script>
</body>
</html>
