<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile - JOY Hardware Products</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'hardware-primary': '#1a365d',
                        'hardware-secondary': '#2d3748',
                        'hardware-accent': '#dd6b20',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/customer/accountEdit.css">
</head>
<body class="bg-gray-50">
    <!-- Header Section -->
    <header class="header-gradient text-white py-4 px-4 lg:px-8">
        <div class="container mx-auto">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                <div class="text-center lg:text-left mb-4 lg:mb-0">
                    <h1 class="text-2xl lg:text-3xl font-bold tracking-tight">JOY Hardware Products</h1>
                    <p class="text-gray-300 mt-1 text-sm lg:text-base">Quality tools for professionals and DIY enthusiasts</p>
                </div>
                <div class="hidden lg:flex items-center space-x-2 text-sm">
                    <span class="text-gray-300">Welcome, <strong><%=user.username%></strong></span>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-white shadow-md py-3 px-4 lg:px-8 sticky top-0 z-10">
        <div class="container mx-auto flex items-center justify-between">
            <!-- Desktop Navigation -->
            <div class="hidden lg:flex items-center space-x-8">
                <a href="/product/<%= user._id %>" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">Home</a>
                <a href="/product" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">Products</a>
                <a href="/deshbord/<%= user._id %>" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">Dashboard</a>
                <a href="/orders" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">My Orders</a>
                <a href="/about" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">About Us</a>
                <a href="/contact" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">Contact</a>
            </div>
            
            <!-- User Icon -->
            <div class="flex items-center space-x-4">
                <a href="/dashboard" class="flex items-center space-x-2 text-hardware-primary hover:text-hardware-accent transition-colors">
                    <div class="relative">
                        <img src="<%= user.profilePhoto[0].url || 'https://thumbs.dreamstime.com/b/default-profile-picture-avatar-photo-placeholder-vector-illustration-default-profile-picture-avatar-photo-placeholder-vector-189495158.jpg' %>" 
                             alt="User Icon" 
                             class="w-10 h-10 rounded-full border-2 border-gray-300 object-cover">
                        <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white"></div>
                    </div>
                    <span class="hidden lg:inline font-medium"><%=user.username%></span>
                </a>
                
                <!-- Mobile Menu Button -->
                <button id="mobile-menu-button" class="lg:hidden text-hardware-primary focus:outline-none">
                    <i class="fas fa-bars text-xl"></i>
                </button>
            </div>
        </div>
        
        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="lg:hidden hidden bg-white shadow-lg rounded-b-lg mt-2 py-4 px-4">
            <div class="flex flex-col space-y-3">
                <a href="/product/<%= user._id %>" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Home</a>
                <a href="/product" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Products</a>
                <a href="/dashboard" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Dashboard</a>
                <a href="/orders" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">My Orders</a>
                <a href="/about" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">About Us</a>
                <a href="/contact" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mx-auto px-4 lg:px-8 py-8">
        <!-- Breadcrumb -->
        <div class="mb-6">
            <nav class="flex" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/dashboard" class="inline-flex items-center text-hardware-primary hover:text-hardware-accent transition-colors">
                            <i class="fas fa-home mr-2"></i> Dashboard
                        </a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                            <span class="text-gray-500">Edit Profile</span>
                        </div>
                    </li>
                </ol>
            </nav>
        </div>

        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-2xl lg:text-3xl font-bold text-hardware-primary mb-2">Edit Profile</h1>
            <p class="text-gray-600">Update your personal information and account settings</p>
        </div>

        

        <!-- Tabs Navigation -->
        <div class="mb-8">
            <div class="border-b border-gray-200">
                <nav class="flex flex-wrap -mb-px">
                    <button id="personal-tab" onclick="switchTab('personal')" class="tab-active mr-2 px-4 py-3 font-medium text-sm rounded-t-lg transition-colors">
                        <i class="fas fa-user mr-2"></i> Personal Information
                    </button>
                    <button id="password-tab" onclick="switchTab('password')" class="tab-inactive mr-2 px-4 py-3 font-medium text-sm rounded-t-lg transition-colors">
                        <i class="fas fa-lock mr-2"></i> Change Password
                    </button>
                    <button id="shipping-tab" onclick="switchTab('shipping')" class="tab-inactive px-4 py-3 font-medium text-sm rounded-t-lg transition-colors">
                        <i class="fas fa-truck mr-2"></i> Shipping Address
                    </button>
                </nav>
            </div>
        </div>

        <!-- Personal Information Tab -->
        <div id="personal-tab-content" class="tab-content active">
            <form action="/account/edit/<%= user._id%>" method="POST" enctype="multipart/form-data" class="space-y-8">
                <!-- Profile Photo Section -->
                <div class="bg-white rounded-xl card-shadow p-6">
                    <h3 class="text-lg font-bold text-hardware-primary mb-4">Profile Photo</h3>
                    <div class="flex flex-col md:flex-row items-center md:items-start space-y-6 md:space-y-0 md:space-x-8">
                        <div class="profile-photo-container relative">
                            <img id="profile-preview" 
                                 src="<%= user.profilePhoto[0].url || 'https://thumbs.dreamstime.com/b/default-profile-picture-avatar-photo-placeholder-vector-illustration-default-profile-picture-avatar-photo-placeholder-vector-189495158.jpg' %>" 
                                 alt="Profile Photo" 
                                 class="w-40 h-40 rounded-full border-4 border-gray-100 object-cover">
                            <div class="profile-photo-overlay absolute inset-0 rounded-full flex items-center justify-center">
                                <i class="fas fa-camera text-white text-2xl"></i>
                            </div>
                        </div>
                        <div class="flex-1">
                            <div class="mb-4">
                                <label class="block text-gray-700 text-sm font-medium mb-2" for="profilePhoto">
                                    Upload New Photo
                                </label>
                                <input type="file" 
                                       id="profilePhoto" 
                                       name="profilePhoto" 
                                       accept="image/*"
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors"
                                       onchange="previewImage(event)">
                                <p class="text-gray-500 text-xs mt-2">Max file size: 5MB. Supported formats: JPG, PNG, GIF</p>
                            </div>
                            <div class="flex space-x-3">
                                <button type="button" onclick="takePhoto()" class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors">
                                    <i class="fas fa-camera-retro mr-2"></i> Take Photo
                                </button>
                                <button type="button" onclick="removePhoto()" class="inline-flex items-center px-4 py-2 bg-red-50 hover:bg-red-100 text-red-700 font-medium rounded-lg transition-colors">
                                    <i class="fas fa-trash-alt mr-2"></i> Remove Photo
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Basic Information -->
                <div class="bg-white rounded-xl card-shadow p-6">
                    <h3 class="text-lg font-bold text-hardware-primary mb-6">Basic Information</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="username">
                                Full Name <span class="text-red-500">*</span>
                            </label>
                            <input type="text" 
                                   id="username" 
                                   name="username" 
                                   value="<%= user.username %>"
                                   required
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                            <p class="text-gray-500 text-xs mt-1">Your full name as it should appear on orders</p>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="email">
                                Email Address <span class="text-red-500">*</span>
                            </label>
                            <input type="email" 
                                   id="email" 
                                   name="email" 
                                   value="<%= user.email %>"
                                   required
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                            <p class="text-gray-500 text-xs mt-1">We'll send order confirmations to this email</p>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="phone">
                                Phone Number <span class="text-red-500">*</span>
                            </label>
                            <div class="flex">
                                <span class="inline-flex items-center px-4 py-3 border border-r-0 border-gray-300 rounded-l-lg bg-gray-50 text-gray-500">
                                    +91
                                </span>
                                <input type="tel" 
                                       id="phone" 
                                       name="phone" 
                                       value="<%= user.phone %>"
                                       pattern="[0-9]{10}"
                                       required
                                       class="w-full px-4 py-3 border border-gray-300 rounded-r-lg input-focus transition-colors">
                            </div>
                            <p class="text-gray-500 text-xs mt-1">10-digit mobile number without country code</p>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="dob">
                                Date of Birth
                            </label>
                            <input type="date" 
                                   id="dob" 
                                   name="dob" 
                                   value="<%= user.dob ? new Date(user.dob).toISOString().split('T')[0] : '' %>"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                        </div>
                    </div>
                </div>

                <!-- Additional Information -->
                <div class="bg-white rounded-xl card-shadow p-6">
                    <h3 class="text-lg font-bold text-hardware-primary mb-6">Additional Information</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="gender">
                                Gender
                            </label>
                            <select id="gender" 
                                    name="gender"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                                <option value="">Select Gender</option>
                                <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>Male</option>
                                <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>Female</option>
                                <option value="other" <%= user.gender === 'other' ? 'selected' : '' %>>Other</option>
                                <option value="prefer-not-to-say" <%= user.gender === 'prefer-not-to-say' ? 'selected' : '' %>>Prefer not to say</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="occupation">
                                Occupation
                            </label>
                            <input type="text" 
                                   id="occupation" 
                                   name="occupation" 
                                   value="<%= user.occupation || '' %>"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors"
                                   placeholder="e.g., Carpenter, Electrician, DIY Enthusiast">
                        </div>
                    </div>
                    
                    <div class="mt-6">
                        <label class="block text-gray-700 text-sm font-medium mb-2" for="bio">
                            Bio/About Me
                        </label>
                        <textarea id="bio" 
                                  name="bio" 
                                  rows="3"
                                  class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors"
                                  placeholder="Tell us a little about yourself..."><%= user.bio || '' %></textarea>
                        <p class="text-gray-500 text-xs mt-1">Maximum 250 characters</p>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
                    <a href="/dashboard" class="inline-flex items-center px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-times mr-2"></i> Cancel
                    </a>
                    <div class="flex space-x-4">
                        <button type="reset" class="inline-flex items-center px-6 py-3 border border-hardware-primary text-hardware-primary font-medium rounded-lg hover:bg-hardware-primary hover:text-white transition-colors">
                            <i class="fas fa-redo mr-2"></i> Reset Changes
                        </button>
                        <button type="submit" class="inline-flex items-center px-6 py-3 bg-hardware-primary hover:bg-hardware-secondary text-white font-medium rounded-lg transition-colors">
                            <i class="fas fa-save mr-2"></i> Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Change Password Tab -->
        <div id="password-tab-content" class="tab-content hidden">
            <form action="/account/change-password" method="POST" class="space-y-8">
                <div class="bg-white rounded-xl card-shadow p-6">
                    <h3 class="text-lg font-bold text-hardware-primary mb-6">Change Password</h3>
                    
                    <div class="space-y-6">
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="currentPassword">
                                Current Password <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <input type="password" 
                                       id="currentPassword" 
                                       name="currentPassword"
                                       required
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                                <button type="button" onclick="togglePassword('currentPassword')" class="absolute right-3 top-3 text-gray-400 hover:text-gray-600">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="newPassword">
                                New Password <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <input type="password" 
                                       id="newPassword" 
                                       name="newPassword"
                                       required
                                       minlength="8"
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                                <button type="button" onclick="togglePassword('newPassword')" class="absolute right-3 top-3 text-gray-400 hover:text-gray-600">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="mt-2 space-y-1">
                                <div class="flex items-center">
                                    <i id="length-check" class="fas fa-circle text-gray-300 text-xs mr-2"></i>
                                    <span class="text-xs text-gray-500">At least 8 characters</span>
                                </div>
                                <div class="flex items-center">
                                    <i id="uppercase-check" class="fas fa-circle text-gray-300 text-xs mr-2"></i>
                                    <span class="text-xs text-gray-500">At least one uppercase letter</span>
                                </div>
                                <div class="flex items-center">
                                    <i id="number-check" class="fas fa-circle text-gray-300 text-xs mr-2"></i>
                                    <span class="text-xs text-gray-500">At least one number</span>
                                </div>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="confirmPassword">
                                Confirm New Password <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <input type="password" 
                                       id="confirmPassword" 
                                       name="confirmPassword"
                                       required
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                                <button type="button" onclick="togglePassword('confirmPassword')" class="absolute right-3 top-3 text-gray-400 hover:text-gray-600">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <p id="password-match" class="text-xs mt-2 hidden"></p>
                        </div>
                    </div>
                    
                    <!-- Password Strength Meter -->
                    <div class="mt-6">
                        <label class="block text-gray-700 text-sm font-medium mb-2">Password Strength</label>
                        <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                            <div id="password-strength" class="h-full w-0 bg-red-500 transition-all duration-300"></div>
                        </div>
                        <div class="flex justify-between text-xs text-gray-500 mt-1">
                            <span>Weak</span>
                            <span>Medium</span>
                            <span>Strong</span>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="flex justify-end">
                    <button type="submit" class="inline-flex items-center px-6 py-3 bg-hardware-primary hover:bg-hardware-secondary text-white font-medium rounded-lg transition-colors">
                        <i class="fas fa-key mr-2"></i> Update Password
                    </button>
                </div>
            </form>
        </div>

        <!-- Shipping Address Tab -->
        <div id="shipping-tab-content" class="tab-content hidden">
            <form action="/address/edit/<%= user._id %>" method="POST" class="space-y-8">
                <div class="bg-white rounded-xl card-shadow p-6">
                    <h3 class="text-lg font-bold text-hardware-primary mb-6">Shipping Address</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="md:col-span-2">
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="addressLine1">
                                Address Line 1 <span class="text-red-500">*</span>
                            </label>
                            <% if(user.address?.[0]?.street1) {%>
                                <input type="text" 
                                   id="addressLine1" 
                                   name="street1"
                                   value="<%= user.address?.[0]?.street1 || '' %>"
                                   required
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                            <% } else { %>
                                <input type="text" 
                                   id="addressLine1" 
                                   name="street1"
                                   required
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors"
                                   placeholder="House No., Building Name, Street">
                            <% } %>
                        </div>
                        
                        <div class="md:col-span-2">
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="addressLine2">
                                Address Line 2
                            </label>
                            <% if(user.address?.[0]?.street2) { %>
                                <input type="text" 
                                   id="addressLine2" 
                                   name="street2"
                                   value="<%= user.address?.[0]?.street2 || '' %>"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                            <% } else {%>
                                <input type="text" 
                                   id="addressLine2" 
                                   name="street2"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors"
                                   placeholder="Area, Landmark">
                            <% } %>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="city">
                                City <span class="text-red-500">*</span>
                            </label>
                            <input type="text" 
                                   id="city" 
                                   name="city"
                                   value="<%= user.address?.[0]?.city || '' %>"
                                   required
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="state">
                                State <span class="text-red-500">*</span>
                            </label>
                            <select id="state" 
                                    name="state"
                                    required
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                                <option value="">Select State</option>
                                <option value="Maharashtra" <%= user.address?.[0]?.state === 'Maharashtra' ? 'selected' : '' %>>Maharashtra</option>
                                <option value="Delhi" <%= user.address?.[0]?.state === 'Gujarat' ? 'selected' : '' %>>Gujarat</option>
                                <option value="Karnataka" <%= user.address?.[0]?.state === 'Karnataka' ? 'selected' : '' %>>Karnataka</option>
                                <option value="Tamil Nadu" <%= user.address?.[0]?.state === 'Tamil Nadu' ? 'selected' : '' %>>Tamil Nadu</option>
                                <option value="Uttar Pradesh" <%= user.address?.[0]?.state === 'Uttar Pradesh' ? 'selected' : '' %>>Uttar Pradesh</option>
                                <!-- Add more states as needed -->
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="pincode">
                                PIN Code <span class="text-red-500">*</span>
                            </label>
                            <input type="text" 
                                   id="pincode" 
                                   name="pincode"
                                   value="<%= user.address?.[0]?.pincode || '' %>"
                                   required
                                   pattern="[0-9]{6}"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-medium mb-2" for="country">
                                Country <span class="text-red-500">*</span>
                            </label>
                            <input type="text" 
                                   id="country" 
                                   name="country"
                                   value="<%= user.address?.[0]?.country || 'India' %>"
                                   required
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg input-focus transition-colors">
                        </div>
                    </div>
                    
                    <div class="mt-6">
                        <label class="flex items-center">
                            <input type="checkbox" 
                                   name="setAsDefault"
                                   <%= user.address?.[0]?.isDefault ? 'checked' : '' %>
                                   class="rounded border-gray-300 text-hardware-accent focus:ring-hardware-accent">
                            <span class="ml-2 text-gray-700 text-sm">Set as default shipping address</span>
                        </label>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="flex justify-end">
                    <button type="submit" class="inline-flex items-center px-6 py-3 bg-hardware-primary hover:bg-hardware-secondary text-white font-medium rounded-lg transition-colors">
                        <i class="fas fa-map-marker-alt mr-2"></i> Save Address
                    </button>
                </div>
            </form>
        </div>

        <!-- Account Deletion Section -->
        <div class="mt-12 pt-8 border-t border-gray-200">
            <div class="bg-red-50 border border-red-200 rounded-xl p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between">
                    <div class="mb-4 md:mb-0">
                        <h3 class="text-lg font-bold text-red-800 mb-1">Delete Account</h3>
                        <p class="text-red-600 text-sm">Once you delete your account, there is no going back. Please be certain.</p>
                    </div>
                    <button type="button" 
                            onclick="confirmDelete()"
                            class="inline-flex items-center px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors">
                        <i class="fas fa-trash-alt mr-2"></i> Delete Account
                    </button>
                </div>
            </div>
        </div>
    </main>

