<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Dashboard - JOY Hardware Products</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'hardware-primary': '#1a365d',
                        'hardware-secondary': '#2d3748',
                        'hardware-accent': '#dd6b20',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/customer/navbar.css">
    <link rel="stylesheet" href="/css/customer/deshbord.css">
</head>
<body class="bg-gray-50">
    <%- include('partials/navbar') %>
            
            <!-- User Icon -->
            <div class="flex items-center space-x-4">
                <a class="flex items-center space-x-2 text-hardware-primary hover:text-hardware-accent transition-colors">
                    <div class="relative">
                        <img src="<%= user.profilePhoto[0]?.url || 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQF02Jj8T2t7PdkytAw42HDuuSz7yXguKn8Lg&s'%>" 
                             alt="User Icon" 
                             class="w-10 h-10 rounded-full border-2 border-gray-300">
                        <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white"></div>
                    </div>
                    <span class="hidden lg:inline font-medium"><%=user.username%></span>
                </a>
                
                <!-- Mobile Menu Button -->
                <button id="mobile-menu-button" class="lg:hidden text-hardware-primary focus:outline-none">
                    <i class="fas fa-bars text-xl"></i>
                </button>
            </div>
        </div>
        
        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="lg:hidden hidden bg-white shadow-lg rounded-b-lg mt-2 py-4 px-4">
            <div class="flex flex-col space-y-3">
                <a href="/buyer/product/<%= user._id %>" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Home</a>
                <a href="/buyer/product/<%= user._id %>" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Products</a>
                <a href="/buyer/about" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">About Us</a>
                <a href="/buyer/contact" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Main Dashboard Content -->
    <main class="container mx-auto px-4 lg:px-8 py-8">
        <!-- Welcome Section -->
        <div class="bg-gradient-to-r from-hardware-primary to-hardware-secondary rounded-xl shadow-lg p-6 lg:p-8 mb-8 text-white">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                <div>
                    <h2 class="text-2xl lg:text-3xl font-bold mb-2">Welcome <%=user.username%>!</h2>
                    <p class="text-gray-200">Here's what's happening with your account today.</p>
                </div>
                <div class="mt-4 lg:mt-0">
                    <span class="inline-flex items-center px-4 py-2 rounded-full bg-hardware-accent text-white text-sm font-medium">
                        <i class="fas fa-crown mr-2"></i> Premium Member
                    </span>
                </div>
            </div>
        </div>

        <!-- Dashboard Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <!-- Account Information Card -->
            <div class="bg-white rounded-xl card-shadow p-6 product-card">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-bold text-hardware-primary">Account Information</h3>
                    <i class="fas fa-user-circle text-hardware-accent text-2xl"></i>
                </div>
                
                <% if (!user || !user.profilePhoto || user.profilePhoto.length === 0 || !user.profilePhoto[0].url) { %>
                    <div class="flex flex-col items-center mb-6">
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQF02Jj8T2t7PdkytAw42HDuuSz7yXguKn8Lg&s" 
                             alt="Profile Photo" 
                             class="w-24 h-24 rounded-full border-4 border-gray-100 mb-4">
                        <p class="text-lg font-bold text-gray-800"><%=user.username%></p>
                        <p class="text-hardware-accent font-medium">Premium Member</p>
                    </div>
                <% } else { %>
                <div class="flex flex-col items-center mb-6">
                    <img src="<%= user.profilePhoto[0].url %>" 
                         alt="Profile Photo" 
                         class="w-24 h-24 rounded-full border-4 border-gray-100 mb-4">
                    <p class="text-lg font-bold text-gray-800"><%=user.username%></p>
                    <p class="text-hardware-accent font-medium">Premium Member</p>
                </div>
                <% } %>
                <div class="space-y-3 mb-6">
                    <div class="flex items-center">
                        <i class="fas fa-envelope text-gray-400 w-6 mr-3"></i>
                        <div>
                            <p class="text-sm text-gray-500">Email</p>
                            <p class="font-medium"><%=user.email%></p>
                        </div>
                    </div>
                    
                    <div class="flex items-center">
                        <i class="fas fa-phone text-gray-400 w-6 mr-3"></i>
                        <div>
                            <p class="text-sm text-gray-500">Phone</p>
                            <p class="font-medium">+91 <%=user.phone%></p>
                        </div>
                    </div>
                    
                    <div class="flex items-center">
                        <i class="fas fa-calendar-alt text-gray-400 w-6 mr-3"></i>
                        <div>
                            <p class="text-sm text-gray-500">Member Since</p>
                            <p class="font-medium"><%=new Date(user.createdAt).toLocaleDateString('en-GB')%></p>
                        </div>
                    </div>
                </div>
                
                <a href="/buyer/accountedit/<%=user._id%>" class="block w-full text-center bg-hardware-primary hover:bg-hardware-secondary text-white font-medium py-3 rounded-lg transition-colors">
                    <i class="fas fa-edit mr-2"></i> Edit Profile
                </a>
            </div>
            
            <!-- Recent Orders Card -->
            <div id="recent-orders" class="bg-white rounded-xl card-shadow p-6 product-card">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-bold text-hardware-primary">Recent Orders</h3>
                    <i class="fas fa-shopping-bag text-hardware-accent text-2xl"></i>
                </div>
                
                <% if (buyOrders && buyOrders.length > 0) { %>
                    <% for (let order of buyOrders.slice(0, 3)) { %>
                        <a href="/buyer/order-details/<%=order.orderid%>" class="block  mb-4">
                        <div class="border border-gray-200 rounded-lg p-4 mb-4 hover:bg-gray-50 transition-colors">
                            <div class="flex justify-between items-start mb-2">
                                <div>
                                    <strong class="text-lg">Order #<%=order.orderid || 'N/A'%></strong>
                                    <p class="text-gray-600 text-sm"><%=order.items?.length || 0%> items - ₹<%=order.totalPrice || 0%></p>
                                </div>
                                <% if(order.status === "Processing") { %>
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">
                                        <%= order.status %>
                                    </span>
                                <% } else if(order.status === "Shipped") { %>
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                                        <%= order.status %>
                                    </span>
                                <% } else if(order.status === "Delivered") { %>
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                                        <%= order.status %>
                                    </span>
                                <% } else { %>
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                                        <%= order.status %>
                                    </span>
                                <% } %>
                            </div>
                            <p class="text-gray-500 text-sm mt-2">
                                <i class="fas fa-calendar-alt mr-2"></i>
                                <%= new Date(order.createdAt || Date.now()).toLocaleDateString('en-GB') %>
                            </p>
                        </div>
                        </a>
                    <% } %>
                <% } else { %>
                    <div class="text-center py-8">
                        <i class="fas fa-shopping-cart text-gray-300 text-4xl mb-4"></i>
                        <p class="text-gray-500">No recent orders</p>
                        <p class="text-gray-400 text-sm mt-1">Start shopping now!</p>
                    </div>
                <% } %>
                
                <a href="#recent-orders" class="block w-full text-center border-2 border-hardware-primary text-hardware-primary hover:bg-hardware-primary hover:text-white font-medium py-3 rounded-lg transition-colors mt-4">
                    <i class="fas fa-list-alt mr-2"></i> View All Orders
                </a>
            </div>
            
            <!-- Quick Actions Card -->
            <div class="bg-white rounded-xl card-shadow p-6 product-card">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-bold text-hardware-primary">Quick Actions</h3>
                    <i class="fas fa-bolt text-hardware-accent text-2xl"></i>
                </div>
                
                <div class="space-y-4">
                    <a href="/buyer/product/<%= user._id %>" class="flex items-center justify-between bg-blue-50 hover:bg-blue-100 text-blue-700 p-4 rounded-lg transition-colors">
                        <div class="flex items-center">
                            <i class="fas fa-shopping-cart text-xl mr-3"></i>
                            <span class="font-medium">Shop Products</span>
                        </div>
                        <i class="fas fa-chevron-right"></i>
                    </a>
                    
                    <a href="/buyer/cart/<%=user._id%>" class="flex items-center justify-between bg-green-50 hover:bg-green-100 text-green-700 p-4 rounded-lg transition-colors">
                        <div class="flex items-center">
                            <i class="fas fa-heart text-xl mr-3"></i>
                            <span class="font-medium">View Cart</span>
                        </div>
                        <i class="fas fa-chevron-right"></i>
                    </a>
                    
                    <a href="/buyer/contact" class="flex items-center justify-between bg-red-50 hover:bg-red-100 text-red-700 p-4 rounded-lg transition-colors">
                        <div class="flex items-center">
                            <i class="fas fa-headset text-xl mr-3"></i>
                            <span class="font-medium">Contact Support</span>
                        </div>
                        <i class="fas fa-chevron-right"></i>
                    </a>
                    
                    <form action="/auth/logout" method="POST">
                        <button type="submit" class="w-full flex items-center justify-between bg-indigo-50 hover:bg-indigo-100 text-indigo-700 p-4 rounded-lg transition-colors">
                            <div class="flex items-center">
                                <i class="fas fa-sign-out-alt text-xl mr-3"></i>
                                <span class="font-medium">Log Out</span>
                            </div>
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-hardware-primary text-white py-8 px-4 lg:px-8">
        <div class="container mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-6 md:mb-0 text-center md:text-left">
                    <h3 class="text-xl font-bold mb-2">JOY Hardware Products</h3>
                    <p class="text-gray-300">Quality tools for professionals and DIY enthusiasts</p>
                </div>
                <div class="text-center md:text-right">
                    <p class="mb-2">
                        <i class="fas fa-envelope mr-2"></i>
                        sales@joyhardware.com
                    </p>
                    <p>
                        <i class="fas fa-phone mr-2"></i>
                        +91 XXXXXXXXXX
                    </p>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-6 text-center text-gray-300">
                <p>&copy; 2023 JOY Hardware Solutions. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script src="/script/customer/deshbord.js"></script>
</body>
</html>
