<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation - JOY Hardware Solutions</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/customer/navbar.css">
    <link rel="stylesheet" href="/css/customer/OrderConfarm.css">
</head>
<body class="bg-gray-50">
    <%- include('partials/navbar') %>

    <div class="max-w-4xl mx-auto px-4 py-8">
        <!-- Success Message Card -->
        <div class="bg-white rounded-2xl shadow-xl p-8 mb-8 text-center border border-gray-100">
            <div class="confirmation-icon">
                <i class="fas fa-check"></i>
            </div>
            <h1 class="text-3xl lg:text-4xl font-bold text-gray-800 mb-3">Thank You For Your Order!</h1>
            <p class="text-gray-600 text-lg mb-4">Your order has been placed successfully and will be processed shortly.</p>
            <div class="order-number">
                <i class="fas fa-hashtag mr-2"></i> Order #<%= order.orderid %>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center mt-6">
                <a href="/buyer/order-details/<%= order.orderid %>" class="btn-primary">
                    <i class="fas fa-eye mr-2"></i> View Order Details
                </a>
                <a href="/buyer/product/<%= userId %>" class="btn-secondary">
                    <i class="fas fa-shopping-cart mr-2"></i> Continue Shopping
                </a>
            </div>
        </div>
        
        <!-- Order Details Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Order Summary Section -->
            <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-100">
                <h2 class="text-xl font-bold text-gray-800 mb-4 pb-2 border-b-2 border-gray-100">
                    <i class="fas fa-shopping-bag mr-2 text-blue-600"></i> Order Summary
                </h2>
                
                <!-- Order Items -->
                <div class="order-items space-y-4 mb-6">
                    <% if(order.items && order.items.length > 0) { %>
                        <% order.items.forEach(item => { %>
                        <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                            <div class="flex-shrink-0 w-16 h-16 bg-white rounded-lg border border-gray-200 flex items-center justify-center overflow-hidden">
                                <img src="<%= item.image %>" alt="<%= item.name %>" class="order-item-img">
                            </div>
                            <div class="ml-4 flex-1">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h3 class="font-semibold text-gray-800"><%= item.name %></h3>
                                        <div class="flex flex-wrap mt-1">
                                            <% if(item.size) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-ruler mr-1"></i> <%= item.size %>
                                            </span>
                                            <% } %>
                                            <% if(item.Material) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-cube mr-1"></i> <%= item.Material %>
                                            </span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <span class="font-bold text-gray-900">₹<%= item.price %></span>
                                        <span class="block text-xs text-gray-500">× <%= item.quantity %></span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center mt-2">
                                    <span class="text-xs text-gray-500">
                                        <i class="fas fa-box mr-1"></i> Qty: <%= item.quantity %>
                                    </span>
                                    <span class="font-semibold text-green-600">₹<%= (item.price * item.quantity).toFixed(2) %></span>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    <% } else { %>
                        <!-- Single Item (Backward Compatibility) -->
                        <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                            <div class="flex-shrink-0 w-16 h-16 bg-white rounded-lg border border-gray-200 flex items-center justify-center overflow-hidden">
                                <img src="<%= order.image %>" alt="<%= order.name %>" class="order-item-img">
                            </div>
                            <div class="ml-4 flex-1">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h3 class="font-semibold text-gray-800"><%= order.name %></h3>
                                        <div class="flex flex-wrap mt-1">
                                            <% if(order.size) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-ruler mr-1"></i> <%= order.size %>
                                            </span>
                                            <% } %>
                                            <% if(order.Material) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-cube mr-1"></i> <%= order.Material %>
                                            </span>
                                            <% } %>
                                            <% if(order.category) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-tag mr-1"></i> <%= order.category %>
                                            </span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <span class="font-bold text-gray-900">₹<%= order.price %></span>
                                        <span class="block text-xs text-gray-500">× <%= order.quantity %></span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center mt-2">
                                    <span class="text-xs text-gray-500">
                                        <i class="fas fa-box mr-1"></i> Qty: <%= order.quantity %>
                                    </span>
                                    <span class="font-semibold text-green-600">₹<%= order.price %></span>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
                
                <!-- Order Totals -->
                <div class="border-t border-gray-200 pt-4">
                    <div class="space-y-2">
                        <div class="flex justify-between text-gray-600">
                            <span>Subtotal:</span>
                            <span class="font-medium">₹<%= order.subtotal %></span>
                        </div>
                        <div class="flex justify-between text-gray-600">
                            <span>Shipping:</span>
                            <span class="font-medium">₹40.00</span>
                        </div>
                        <div class="flex justify-between text-gray-600">
                            <span>Tax (18%):</span>
                            <span class="font-medium"><%= order.tax || (order.subtotal * 0.18).toFixed(2) %></span>
                        </div>
                        <div class="order-total-row total flex justify-between">
                            <span class="font-bold text-gray-800">Total:</span>
                            <span class="text-xl font-bold text-blue-600">₹<%= order.totalPrice %></span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Delivery & Payment Information -->
            <div class="space-y-8">
                <!-- Delivery Information -->
                <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-100">
                    <h2 class="text-xl font-bold text-gray-800 mb-4 pb-2 border-b-2 border-gray-100">
                        <i class="fas fa-truck mr-2 text-blue-600"></i> Delivery Information
                    </h2>
                    <div class="space-y-3">
                        <div class="flex items-start">
                            <div class="w-8 h-8 bg-blue-50 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                                <i class="fas fa-user text-blue-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-gray-800"><%= order.firstname %> <%= order.lastname %></p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="w-8 h-8 bg-blue-50 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                                <i class="fas fa-map-marker-alt text-blue-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-gray-700"><%= order.address %></p>
                                <p class="text-gray-700"><%= order.city %>, <%= order.state %> - <%= order.pincode %></p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="w-8 h-8 bg-blue-50 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                                <i class="fas fa-phone text-blue-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-gray-700">+91 <%= order.phone %></p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <div class="w-8 h-8 bg-blue-50 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                                <i class="fas fa-envelope text-blue-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-gray-700"><%= order.email %></p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Payment Information -->
                <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-100">
                    <h2 class="text-xl font-bold text-gray-800 mb-4 pb-2 border-b-2 border-gray-100">
                        <i class="fas fa-credit-card mr-2 text-blue-600"></i> Payment Information
                    </h2>
                    <div class="space-y-3">
                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-8 h-8 bg-green-50 rounded-full flex items-center justify-center mr-3">
                                    <i class="fas fa-check-circle text-green-600 text-sm"></i>
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-800">Payment Status</p>
                                    <p class="text-sm text-gray-600"><%= order.paymentMethod %></p>
                                </div>
                            </div>
                            <span class="px-3 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">
                                Paid
                            </span>
                        </div>
                        
                        <div class="flex items-start p-3 bg-gray-50 rounded-lg">
                            <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                                <i class="fas fa-hashtag text-gray-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="font-semibold text-gray-800">Transaction ID</p>
                                <p class="text-sm text-gray-600 break-all"><%= order.transactionId %></p>
                            </div>
                        </div>
                        
                        <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
                            <div class="flex items-center">
                                <i class="fas fa-indian-rupee-sign text-blue-600 mr-2"></i>
                                <span class="font-semibold text-gray-800">Amount Paid</span>
                            </div>
                            <span class="text-xl font-bold text-blue-600">₹<%= order.totalPrice %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Estimated Delivery -->
        <div class="mt-8 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-100">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-4">
                        <i class="fas fa-clock text-blue-600 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-800">Estimated Delivery</h3>
                        <p class="text-gray-600">
                            <% 
                                let deliveryDate = new Date();
                                deliveryDate.setDate(deliveryDate.getDate() + 5);
                                let options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                            %>
                            <%= deliveryDate.toLocaleDateString('en-US', options) %>
                        </p>
                    </div>
                </div>
                <div class="flex items-center">
                    <i class="fas fa-truck text-blue-600 mr-2"></i>
                    <span class="text-gray-700">Free Shipping</span>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-gray-800 text-white py-6 mt-12">
        <div class="container mx-auto px-4 text-center">
            <p class="mb-2">&copy; 2023 JOY Hardware Solutions. All Rights Reserved.</p>
            <p class="mb-2">Registered Office: 123 Industrial Area, Mumbai, Maharashtra - 400001</p>
            <p>Contact: support@joyhardware.com | Customer Care: +91 1800 123 4567</p>
        </div>
    </footer>
    <script src="/script/customer/OrderConfarm.js"></script>

</body>
</html>
