<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - JOY Hardware Solutions</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/customer/navbar.css">
    <link rel="stylesheet" href="/css/customer/checkout.css">

</head>
<body class="bg-gray-50">
    <%- include('partials/navbar') %>
    
    <form id="shippingForm" action="/buyer/product/buy/<%=order.orderid%>" method="POST" class="p-4 md:p-6">
        <div class="checkout-container">
            <div class="flex flex-col lg:flex-row gap-6">
                <!-- Shipping Information -->
                <div class="lg:w-2/3">
                    <div class="bg-white rounded-xl shadow-lg p-6">
                        <h2 class="section-title">Shipping Information</h2>
                        
                        <!-- Saved Address Option -->
                        <% if(user.address.length > 0) { %>
                        <div class="saved-address-option mb-6">
                            <div class="address-card" id="savedAddressCard">
                                <div class="flex items-start">
                                    <input type="checkbox" id="useSavedAddress" name="useSavedAddress" value="true" 
                                           class="mt-1 mr-3 h-5 w-5 text-blue-600 rounded focus:ring-blue-500">
                                    <label for="useSavedAddress" class="flex-1 cursor-pointer">
                                        <div class="flex items-center justify-between mb-2">
                                            <strong class="text-lg text-gray-800">Use Saved Address</strong>
                                            <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded">Default</span>
                                        </div>
                                        <div class="address-details space-y-1">
                                            <p class="font-semibold text-gray-800"><i class="fas fa-user mr-2"></i><%= user.username %></p>
                                            <p class="text-gray-700"><i class="fas fa-map-marker-alt mr-2"></i><%= user.address[0].street1 %></p>
                                            <% if(user.address[0].street2) { %>
                                                <p class="text-gray-700 pl-7"><%= user.address[0].street2 %></p>
                                            <% } %>
                                            <p class="text-gray-700"><i class="fas fa-city mr-2"></i><%= user.address[0].city %>, <%= user.address[0].state %></p>
                                            <p class="text-gray-700"><i class="fas fa-mail-bulk mr-2"></i><%= user.address[0].pincode %>, <%= user.address[0].country || 'India' %></p>
                                            <p class="text-gray-700"><i class="fas fa-phone mr-2"></i><%= user.phone %></p>
                                            <p class="text-gray-700"><i class="fas fa-envelope mr-2"></i><%= user.email %></p>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div id="savedUserData"
                            data-firstname="<%= user.username.split(' ')[0] %>"
                            data-lastname="<%= user.username.split(' ').slice(1).join(' ') %>"
                            data-email="<%= user.email %>"
                            data-phone="<%= user.phone %>"
                            data-address="<%= user.address[0].street1 || '' %>"
                            data-city="<%= user.address[0].city || '' %>"
                            data-state="<%= user.address[0].state || '' %>"
                            data-pincode="<%= user.address[0].pincode || '' %>">
                        </div>

                        <div class="or-separator">
                            <span>OR</span>
                        </div>
                        <% } %>
                        
                        <!-- Address Form -->
                        <div id="addressFormSection" class="<%= user.address.length > 0 ? '' : 'mt-6' %>">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="form-group">
                                    <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">First Name*</label>
                                    <input type="text" name="firstname" id="firstName" required
                                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                                
                                <div class="form-group">
                                    <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">Last Name*</label>
                                    <input type="text" name="lastname" id="lastName" required
                                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                            </div>
                            
                            <div class="mt-4">
                                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email Address*</label>
                                <input type="email" name="email" id="email" required
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            
                            <div class="mt-4">
                                <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">Phone Number*</label>
                                <input type="tel" name="phone" id="phone" required
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            
                            <div class="mt-4">
                                <label for="address" class="block text-sm font-medium text-gray-700 mb-2">Street Address*</label>
                                <textarea id="address" name="address" rows="3" required
                                          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                            </div>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                                <div>
                                    <label for="city" class="block text-sm font-medium text-gray-700 mb-2">City*</label>
                                    <input type="text" name="city" id="city" required
                                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                                
                                <div>
                                    <label for="state" class="block text-sm font-medium text-gray-700 mb-2">State*</label>
                                    <select id="state" name="state" required
                                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                        <option value="">Select State</option>
                                        <option value="MH">Maharashtra</option>
                                        <option value="KA">Karnataka</option>
                                        <option value="TN">Tamil Nadu</option>
                                        <option value="DL">Delhi</option>
                                        <option value="Gujarat">Gujarat</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                                <div>
                                    <label for="pincode" class="block text-sm font-medium text-gray-700 mb-2">Pincode*</label>
                                    <input type="text" name="pincode" id="pincode" required
                                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                                
                                <div>
                                    <label for="country" class="block text-sm font-medium text-gray-700 mb-2">Country*</label>
                                    <input type="text" id="country" name="country" value="India" readonly
                                           class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Order Summary -->
                <div class="lg:w-1/3">
                    <div class="bg-white rounded-xl shadow-lg p-6 sticky top-6">
                        <h2 class="section-title">Your Order</h2>
                        
                        <!-- Order Items -->
                        <div class="order-items mb-6">
                            <% for(let ord of order.items) { %>
                            <div class="order-item">
                                <img src="<%= ord.image || '/image/placeholder-product.svg' %>" alt="<%=ord.name%>" class="order-item-img" onerror="this.onerror=null;this.src='/image/placeholder-product.svg';">
                                <div class="ml-4 flex-1">
                                    <div class="order-item-name font-semibold text-lg text-gray-800 mb-2"><%=ord.name%></div>
                                    
                                    <!-- Size and Material Information -->
                                    <div class="mb-3">
                                        <% if(ord.size) { %>
                                        <span class="spec-badge">
                                            <i class="fas fa-ruler mr-1"></i> Size: <%=ord.size%>
                                        </span>
                                        <% } %>
                                        
                                        <% if(ord.Material) { %>
                                        <span class="spec-badge">
                                            <i class="fas fa-cube mr-1"></i> Material: <%=ord.Material%>
                                        </span>
                                        <% } %>
                                        
                                        <% if(ord.category) { %>
                                        <span class="spec-badge">
                                            <i class="fas fa-tag mr-1"></i> Category: <%=ord.category%>
                                        </span>
                                        <% } %>
                                    </div>
                                    
                                    <!-- Quantity and Price -->
                                    <div class="text-gray-600 text-sm mb-2">
                                        <div class="flex justify-between">
                                            <span><i class="fas fa-box mr-1"></i> Quantity:</span>
                                            <span class="font-medium"><%=ord.quantity%></span>
                                        </div>
                                    </div>
                                    
                                    <!-- Hidden inputs for size, material, and category -->
                                    <% if(ord.size) { %>
                                    <input type="hidden" name="size" value="<%=ord.size%>">
                                    <% } %>
                                    
                                    <% if(ord.Material) { %>
                                    <input type="hidden" name="Material" value="<%=ord.Material%>">
                                    <% } %>
                                    
                                    <% if(ord.category) { %>
                                    <input type="hidden" name="category" value="<%=ord.category%>">
                                    <% } %>
                                    
                                    <!-- Price -->
                                    <div class="order-item-price text-xl font-bold text-green-600 mt-2">
                                        ₹<%=ord.price%>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        </div>
                        
                        <!-- Order Totals -->
                        <div class="order-totals border-t border-gray-200 pt-4">
                            <div class="order-total-row flex justify-between mb-2">
                                <span class="text-gray-600">Subtotal:</span>
                                <span class="font-medium">₹<%=order.subtotal%></span>
                            </div>
                            
                            <div class="order-total-row flex justify-between mb-2">
                                <span class="text-gray-600">Shipping:</span>
                                <span id="shippingCost" class="font-medium">₹40.00</span>
                            </div>
                            
                            <div class="order-total-row flex justify-between mb-2">
                                <span class="text-gray-600">Tax (18%):</span>
                                <span id="taxAmount" class="font-medium"><%= order.tax %></span>
                            </div>
                            
                            <div class="order-total-row total flex justify-between mt-4 pt-4">
                                <span class="text-gray-800">Total:</span>
                                <span id="totalAmount" class="text-xl font-bold text-blue-600">₹<%=order.totalPrice%></span>
                            </div>
                        </div>
                        
                        <!-- Place Order Button -->
                        <button type="submit" class="place-order-btn mt-6 flex items-center justify-center">
                            <i class="fas fa-shopping-bag mr-2"></i> Place Order
                        </button>
                        
                        <!-- Payment Method Info -->
                        <div class="mt-4 text-center text-sm text-gray-500">
                            <i class="fas fa-lock mr-1"></i> Secure Payment • SSL Encrypted
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <footer class="bg-gray-800 text-white py-6 mt-16">
        <div class="container mx-auto px-4 text-center">
            <p class="text-sm">&copy; 2023 JOY Hardware Solutions. All Rights Reserved.</p>
            <p class="text-sm mt-2">Contact: sales@joyhardware.com | Phone: +91 7201956899</p>
        </div>
    </footer>

    <script src="/script/customer/checkout.js"></script>
</body>
</html>
