<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment - JOY Hardware Solutions</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/customer/navbar.css">
    <link rel="stylesheet" href="/css/customer/payment.css">

</head>
<body class="bg-gray-50">
    <%- include('partials/navbar') %>

    <div class="payment-container px-4 py-8">
        <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
            <h1 class="text-2xl lg:text-3xl font-bold text-gray-800 mb-2">Complete Your Purchase</h1>
            <p class="text-gray-600">Secure payment with multiple options available</p>
        </div>
        
        <form action="/buyer/product/confirm/<%=order.orderId%>" method="POST">
            <div class="flex flex-col lg:flex-row gap-6">
                <!-- Payment Methods Section -->
                <div class="lg:w-2/3">
                    <div class="bg-white rounded-xl shadow-lg p-6">
                        <h2 class="section-title">Payment Methods</h2>
                        
                        <!-- UPI Payment Method -->
                        <div class="payment-method active" id="upiMethod">
                            <div class="payment-method-header active" onclick="togglePaymentMethod('upiMethod')">
                                <div class="flex items-center">
                                    <input type="radio" name="paymentMethod" id="upiRadio" value="UPI" class="h-4 w-4 text-blue-600 focus:ring-blue-500" checked>
                                    <label for="upiRadio" class="ml-2 font-medium text-gray-700">UPI Payment</label>
                                </div>
                                <img src="https://via.placeholder.com/80x30?text=UPI" alt="UPI" class="h-8 object-contain">
                            </div>
                            <div class="payment-method-content">
                                <div class="form-group">
                                    <label for="upiId">Enter UPI ID</label>
                                    <input type="text" id="upiId" placeholder="yourname@upi" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                </div>
                                <p class="text-sm text-gray-600 mt-4 mb-2">Or pay using:</p>
                                <div class="upi-apps">
                                    <div class="upi-app">
                                        <img src="https://via.placeholder.com/40x40?text=GPay" alt="Google Pay" class="w-10 h-10 object-contain">
                                    </div>
                                    <div class="upi-app">
                                        <img src="https://via.placeholder.com/40x40?text=PhonePe" alt="PhonePe" class="w-10 h-10 object-contain">
                                    </div>
                                    <div class="upi-app">
                                        <img src="https://via.placeholder.com/40x40?text=PayTM" alt="PayTM" class="w-10 h-10 object-contain">
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Card Payment Method -->
                        <div class="payment-method" id="cardMethod">
                            <div class="payment-method-header" onclick="togglePaymentMethod('cardMethod')">
                                <div class="flex items-center">
                                    <input type="radio" name="paymentMethod" id="cardRadio" value="Card" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                    <label for="cardRadio" class="ml-2 font-medium text-gray-700">Credit/Debit Card</label>
                                </div>
                                <div>
                                    <img src="https://via.placeholder.com/80x30?text=Cards" alt="Cards" class="h-8 object-contain">
                                </div>
                            </div>
                            <div class="payment-method-content">
                                <div class="form-group">
                                    <label for="cardNumber">Card Number</label>
                                    <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456">
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="expiryDate">Expiry Date</label>
                                        <input type="text" id="expiryDate" placeholder="MM/YY">
                                    </div>
                                    <div class="form-group">
                                        <label for="cvv">CVV</label>
                                        <input type="text" id="cvv" placeholder="123">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="cardName">Name on Card</label>
                                    <input type="text" id="cardName" placeholder="Your Name">
                                </div>
                            </div>
                        </div>
                        
                        <!-- Net Banking -->
                        <div class="payment-method" id="netBankingMethod">
                            <div class="payment-method-header" onclick="togglePaymentMethod('netBankingMethod')">
                                <div class="flex items-center">
                                    <input type="radio" name="paymentMethod" id="netBankingRadio" value="Net Banking" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                    <label for="netBankingRadio" class="ml-2 font-medium text-gray-700">Net Banking</label>
                                </div>
                                <img src="https://via.placeholder.com/80x30?text=NetBanking" alt="Net Banking" class="h-8 object-contain">
                            </div>
                            <div class="payment-method-content">
                                <div class="form-group">
                                    <label for="bankSelect">Select Bank</label>
                                    <select id="bankSelect" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                        <option value="">-- Select Bank --</option>
                                        <option value="sbi">State Bank of India</option>
                                        <option value="hdfc">HDFC Bank</option>
                                        <option value="icici">ICICI Bank</option>
                                        <option value="axis">Axis Bank</option>
                                        <option value="pnb">Punjab National Bank</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                        <!-- COD -->
                        <div class="payment-method" id="codMethod">
                            <div class="payment-method-header" onclick="togglePaymentMethod('codMethod')">
                                <div class="flex items-center">
                                    <input type="radio" name="paymentMethod" id="codRadio" value="Cash on Delivery" class="h-4 w-4 text-blue-600 focus:ring-blue-500">
                                    <label for="codRadio" class="ml-2 font-medium text-gray-700">Cash on Delivery (COD)</label>
                                </div>
                                <img src="https://via.placeholder.com/80x30?text=COD" alt="COD" class="h-8 object-contain">
                            </div>
                            <div class="payment-method-content">
                                <p class="text-gray-600">Pay cash when your order is delivered. Additional ₹50 COD charge may apply.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Order Summary (Styled like checkout.ejs) -->
                <div class="lg:w-1/3">
                    <div class="bg-white rounded-xl shadow-lg p-6 sticky top-6">
                        <h2 class="section-title">Your Order</h2>
                        
                        <!-- Order Items -->
                        <div class="order-items mb-6">
                            <% if(order.items && order.items.length > 0) { %>
                                <% order.items.forEach(item => { %>
                                <div class="order-item flex p-4 border border-gray-200 rounded-lg mb-4">
                                    <img src="<%= item.image || '/image/placeholder-product.svg' %>" alt="<%= item.name %>" class="order-item-img" onerror="this.onerror=null;this.src='/image/placeholder-product.svg';">
                                    <div class="ml-4 flex-1">
                                        <div class="order-item-name font-semibold text-lg text-gray-800 mb-2"><%= item.name %></div>
                                        
                                        <!-- Size and Material Information -->
                                        <div class="mb-3">
                                            <% if(item.size) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-ruler mr-1"></i> Size: <%= item.size %>
                                            </span>
                                            <% } %>
                                            
                                            <% if(item.Material) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-cube mr-1"></i> Material: <%= item.Material %>
                                            </span>
                                            <% } %>
                                            
                                            <% if(item.category) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-tag mr-1"></i> Category: <%= item.category %>
                                            </span>
                                            <% } %>
                                        </div>
                                        
                                        <!-- Quantity and Price -->
                                        <div class="text-gray-600 text-sm mb-2">
                                            <div class="flex justify-between">
                                                <span><i class="fas fa-box mr-1"></i> Quantity:</span>
                                                <span class="font-medium"><%= item.quantity %></span>
                                            </div>
                                        </div>
                                        
                                        <!-- Price -->
                                        <div class="order-item-price text-xl font-bold text-green-600 mt-2">
                                            ₹<%= (item.price * item.quantity).toFixed(2) %>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <div class="order-item flex p-4 border border-gray-200 rounded-lg mb-4">
                                    <img src="<%= order.image || '/image/placeholder-product.svg' %>" alt="<%=order.name%>" class="order-item-img" onerror="this.onerror=null;this.src='/image/placeholder-product.svg';">
                                    <div class="ml-4 flex-1">
                                        <div class="order-item-name font-semibold text-lg text-gray-800 mb-2"><%=order.name%></div>
                                        
                                        <!-- Size and Material Information -->
                                        <div class="mb-3">
                                            <% if(order.size) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-ruler mr-1"></i> Size: <%=order.size%>
                                            </span>
                                            <% } %>
                                            
                                            <% if(order.Material) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-cube mr-1"></i> Material: <%=order.Material%>
                                            </span>
                                            <% } %>
                                            
                                            <% if(order.category) { %>
                                            <span class="spec-badge">
                                                <i class="fas fa-tag mr-1"></i> Category: <%=order.category%>
                                            </span>
                                            <% } %>
                                        </div>
                                        
                                        <!-- Quantity and Price -->
                                        <div class="text-gray-600 text-sm mb-2">
                                            <div class="flex justify-between">
                                                <span><i class="fas fa-box mr-1"></i> Quantity:</span>
                                                <span class="font-medium"><%=order.quantity%></span>
                                            </div>
                                        </div>
                                        
                                        <!-- Price -->
                                        <div class="order-item-price text-xl font-bold text-green-600 mt-2">
                                            ₹<%=order.price%>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Order Totals -->
                        <div class="order-totals border-t border-gray-200 pt-4">
                            <div class="order-total-row flex justify-between mb-2">
                                <span class="text-gray-600">Subtotal:</span>
                                <span class="font-medium">₹<%= order.subtotal %></span>
                            </div>
                            
                            <div class="order-total-row flex justify-between mb-2">
                                <span class="text-gray-600">Shipping:</span>
                                <span class="font-medium">₹40.00</span>
                            </div>
                            
                            <div class="order-total-row flex justify-between mb-2">
                                <span class="text-gray-600">Tax (18%):</span>
                                <span class="font-medium"><%= order.tax || (order.subtotal * 0.18).toFixed(2) %></span>
                            </div>
                            
                            <div class="order-total-row total flex justify-between mt-4 pt-4">
                                <span class="text-gray-800">Total:</span>
                                <span class="text-xl font-bold text-blue-600">₹<%= order.totalPrice %></span>
                            </div>
                        </div>
                        
                        <!-- Delivery Address -->
                        <div class="mt-6 p-4 bg-gray-50 rounded-lg">
                            <h3 class="font-semibold text-gray-800 mb-2 flex items-center">
                                <i class="fas fa-truck mr-2"></i> Delivery Address
                            </h3>
                            <p class="text-gray-700 text-sm leading-relaxed">
                                <span class="font-medium"><%=order.firstname%> <%=order.lastname%></span><br>
                                <%=order.address%><br>
                                <%=order.city%>, <%=order.state%> - <%=order.pincode%><br>
                                <span class="flex items-center mt-1">
                                    <i class="fas fa-phone mr-1 text-xs"></i> +91 <%=order.phone%>
                                </span>
                                <span class="flex items-center mt-1">
                                    <i class="fas fa-envelope mr-1 text-xs"></i> <%=order.email%>
                                </span>
                            </p>
                        </div>
                        
                        <!-- Pay Button -->
                        <button type="submit" class="pay-button mt-6 flex items-center justify-center">
                            <i class="fas fa-lock mr-2"></i> Pay ₹<%= order.totalPrice %>
                        </button>
                        
                        <!-- Secure Payment Info -->
                        <div class="mt-4 text-center text-xs text-gray-500">
                            <i class="fas fa-shield-alt mr-1"></i> Your payment information is secure
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <footer>
        <p>&copy; 2023 JOY Hardware Solutions. All Rights Reserved.</p>
        <p>Contact: sales@joyhardware.com | Phone: +91 7201956899</p>
    </footer>

        <script src="/script/customer/payment.js"></script>

</body>
</html>
