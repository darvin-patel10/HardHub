<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - JOY Hardware Products</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'hardware-primary': '#1a365d',
                        'hardware-secondary': '#2d3748',
                        'hardware-accent': '#dd6b20',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/customer/Order-details.css">
</head>
<body class="bg-gray-50">
    <!-- Header Section -->
    <header class="header-gradient text-white py-4 px-4 lg:px-8 no-print">
        <div class="container mx-auto">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                <div class="text-center lg:text-left mb-4 lg:mb-0">
                    <h1 class="text-2xl lg:text-3xl font-bold tracking-tight">JOY Hardware Products</h1>
                    <p class="text-gray-300 mt-1 text-sm lg:text-base">Quality tools for professionals and DIY enthusiasts</p>
                </div>
                <div class="hidden lg:flex items-center space-x-2 text-sm">
                    <span class="text-gray-300">Welcome, <strong><%=user.username%></strong></span>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-white shadow-md py-3 px-4 lg:px-8 sticky top-0 z-10 no-print">
        <div class="container mx-auto flex items-center justify-between">
            <!-- Desktop Navigation -->
            <div class="hidden lg:flex items-center space-x-8">
                <a href="/product/<%= user._id %>" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">Home</a>
                <a href="/product" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">Products</a>
                <a href="/orders" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">My Orders</a>
                <a href="/about" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">About Us</a>
                <a href="/contact" class="text-hardware-primary font-medium hover:text-hardware-accent transition-colors">Contact</a>
            </div>
            
            <!-- User Icon -->
            <div class="flex items-center space-x-4">
                <a href="/dashboard" class="flex items-center space-x-2 text-hardware-primary hover:text-hardware-accent transition-colors">
                    <div class="relative">
                        <img src="https://thumbs.dreamstime.com/b/default-profile-picture-avatar-photo-placeholder-vector-illustration-default-profile-picture-avatar-photo-placeholder-vector-189495158.jpg" 
                             alt="User Icon" 
                             class="w-10 h-10 rounded-full border-2 border-gray-300">
                    </div>
                    <span class="hidden lg:inline font-medium"><%=user.username%></span>
                </a>
                
                <!-- Mobile Menu Button -->
                <button id="mobile-menu-button" class="lg:hidden text-hardware-primary focus:outline-none">
                    <i class="fas fa-bars text-xl"></i>
                </button>
            </div>
        </div>
        
        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="lg:hidden hidden bg-white shadow-lg rounded-b-lg mt-2 py-4 px-4 no-print">
            <div class="flex flex-col space-y-3">
                <a href="/product/<%= user._id %>" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Home</a>
                <a href="/product" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Products</a>
                <a href="/orders" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">My Orders</a>
                <a href="/about" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">About Us</a>
                <a href="/contact" class="text-hardware-primary font-medium py-2 px-3 hover:bg-gray-100 rounded transition-colors">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mx-auto px-4 lg:px-8 py-8">
        <!-- Print Section for Invoice -->
        <div id="print-section" class="bg-white p-8 rounded-lg">
            <!-- Invoice Header (Print Only) -->
            <div class="print-only mb-8 border-b pb-6">
                <div class="flex justify-between items-start">
                    <div>
                        <h1 class="text-3xl font-bold text-hardware-primary">JOY Hardware Products</h1>
                        <p class="text-gray-600">Quality tools for professionals and DIY enthusiasts</p>
                        <p class="text-gray-600 mt-2">sales@joyhardware.com | +91 XXXXXXXXXX</p>
                    </div>
                    <div class="text-right">
                        <h2 class="text-2xl font-bold text-hardware-primary">INVOICE</h2>
                        <p class="text-gray-600">Invoice #<%= order.orderid || 'N/A' %></p>
                        <p class="text-gray-600">Date: <%= new Date(order.createdAt).toLocaleDateString('en-GB') %></p>
                    </div>
                </div>
            </div>

            <!-- Back Button and Order Header -->
            <div class="mb-6 no-print">
                <a href="/deshbord/<%= user._id %>" class="inline-flex items-center text-hardware-primary hover:text-hardware-accent transition-colors mb-4">
                    <i class="fas fa-arrow-left mr-2"></i> Back to Orders
                </a>
                
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <h1 class="text-2xl lg:text-3xl font-bold text-hardware-primary">Order Details</h1>
                        <p class="text-gray-600 mt-1">Order #<%= order.orderid || 'N/A' %></p>
                    </div>
                    
                    <div class="mt-4 lg:mt-0 flex items-center space-x-3">
                        <% if(order.status === "Processing") { %>
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-yellow-100 text-yellow-800 text-sm font-medium">
                                <i class="fas fa-clock mr-2"></i> <%= order.status %>
                            </span>
                        <% } else if(order.status === "Shipped") { %>
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-blue-100 text-blue-800 text-sm font-medium">
                                <i class="fas fa-shipping-fast mr-2"></i> <%= order.status %>
                            </span>
                        <% } else if(order.status === "Delivered") { %>
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-green-100 text-green-800 text-sm font-medium">
                                <i class="fas fa-check-circle mr-2"></i> <%= order.status %>
                            </span>
                        <% } else if(order.status === "Cancelled") { %>
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-red-100 text-red-800 text-sm font-medium">
                                <i class="fas fa-times-circle mr-2"></i> <%= order.status %>
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-gray-100 text-gray-800 text-sm font-medium">
                                <i class="fas fa-info-circle mr-2"></i> <%= order.status %>
                            </span>
                        <% } %>
                        
                        <button onclick="printInvoice()" class="inline-flex items-center px-4 py-2 bg-hardware-primary hover:bg-hardware-secondary text-white rounded-lg transition-colors">
                            <i class="fas fa-print mr-2"></i> Print Invoice
                        </button>
                    </div>
                </div>
            </div>

            <!-- Order Summary Cards -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                <!-- Order Information -->
                <div class="bg-white rounded-xl card-shadow p-6">
                    <h3 class="text-lg font-bold text-hardware-primary mb-4">Order Information</h3>
                    <div class="space-y-3">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Order ID:</span>
                            <span class="font-medium">#<%= order.orderid || 'N/A' %></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Order Date:</span>
                            <span class="font-medium"><%= new Date(order.createdAt).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Total Items:</span>
                            <span class="font-medium">
                                <% 
                                    let totalItems = 0;
                                    if(order.items && order.items.length > 0) {
                                        order.items.forEach(item => {
                                            totalItems += item.quantity || 1;
                                        });
                                    }
                                %>
                                <%= totalItems %> items
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Payment Method:</span>
                            <span class="font-medium"><%= order.paymentMethod || 'Cash on Delivery' %></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Payment Status:</span>
                            <span class="font-medium <%= order.paymentStatus === 'Paid' ? 'text-green-600' : order.paymentStatus === 'Pending' ? 'text-yellow-600' : 'text-red-600' %>">
                                <%= order.paymentStatus || 'Pending' %>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Customer Information -->
                <div class="bg-white rounded-xl card-shadow p-6">
                    <h3 class="text-lg font-bold text-hardware-primary mb-4">Customer Information</h3>
                    <div class="space-y-3">
                        <div>
                            <p class="text-gray-600 text-sm">Name</p>
                            <p class="font-medium"><%= order.firstname %> <%= order.lastname %></p>
                        </div>
                        <div>
                            <p class="text-gray-600 text-sm">Email</p>
                            <p class="font-medium"><%= order.email %></p>
                        </div>
                        <div>
                            <p class="text-gray-600 text-sm">Phone</p>
                            <p class="font-medium">+91 <%= order.phone %></p>
                        </div>
                    </div>
                </div>

                <!-- Shipping Information -->
                <div class="bg-white rounded-xl card-shadow p-6">
                    <h3 class="text-lg font-bold text-hardware-primary mb-4">Shipping Information</h3>
                    <div class="space-y-3">
                            <div>
                                <p class="text-gray-600 text-sm">Address</p>
                                <p class="font-medium"><%= order.address || '' %></p>
                                <p class="font-medium"><%= order.city || '' %>, <%= order.state || '' %></p>
                                <p class="font-medium"><%= order.pincode || '' %></p>
                            </div>
                            <div>
                                <p class="text-gray-600 text-sm">Estimated Delivery</p>
                            </div>
                    </div>
                </div>
            </div>

            <!-- Order Items Table -->
            <div class="bg-white rounded-xl card-shadow p-6 mb-8">
                <h3 class="text-lg font-bold text-hardware-primary mb-6">Order Items (<%= order.items?.length || 0 %> products, <%= totalItems %> total items)</h3>
                
                <% if(order.items && order.items.length > 0) { %>
                    <%
                        let subtotal = 0;
                        let taxRate = 0.18; // 18% GST
                        let taxAmount = 0;
                        let shippingCharge = order.shippingFee || 100;
                        let discount = order.discount || 0;
                        let grandTotal = 0;
                    %>
                    
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead>
                                <tr class="bg-gray-50">
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Unit Price</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item Total</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% order.items.forEach(item => { 
                                    const itemPrice = item.price || 0;
                                    const itemQuantity = item.quantity || 1;
                                    const itemTotal = itemPrice * itemQuantity;
                                    subtotal += itemTotal;
                                %>
                                <tr class="product-card hover:bg-gray-50">
                                    <td class="px-4 py-4">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 h-16 w-16 bg-gray-100 rounded-lg flex items-center justify-center mr-4">
                                                <% if(item.image) { %>
                                                    <img src="<%= item.image %>" alt="<%= item.name %>" class="h-12 w-12 object-contain">
                                                <% } else { %>
                                                    <i class="fas fa-box text-gray-400 text-2xl"></i>
                                                <% } %>
                                            </div>
                                            <div>
                                                <div class="font-medium text-hardware-primary"><%= item.name %></div>
                                                <% if(item.description) { %>
                                                    <div class="text-sm text-gray-500 mt-1"><%= item.description %></div>
                                                <% } %>
                                                <% if(item.productCode) { %>
                                                    <div class="text-xs text-gray-400 mt-1">SKU: <%= item.productCode %></div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-4">
                                        <div class="font-medium">₹<%= itemPrice.toFixed(2) %></div>
                                        <% if(item.originalPrice && item.originalPrice > itemPrice) { %>
                                            <div class="text-xs text-gray-400 line-through">₹<%= item.originalPrice.toFixed(2) %></div>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-4">
                                        <span class="inline-flex items-center px-3 py-1 rounded-full bg-blue-50 text-blue-700 font-medium">
                                            <i class="fas fa-box-open mr-2"></i> <%= itemQuantity %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-4">
                                        <span class="font-bold text-lg">₹<%= itemTotal.toFixed(2) %></span>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Order Calculation Summary -->
                    <div class="mt-8 pt-6 border-t border-gray-200">
                        <div class="flex justify-end">
                            <div class="w-full md:w-1/2 lg:w-1/3">
                                <div class="space-y-3">
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Subtotal (<%= totalItems %> items):</span>
                                        <span class="font-medium">₹<%= subtotal.toFixed(2) %></span>
                                    </div>
                                    
                                    <% if(discount > 0) { %>
                                    <div class="flex justify-between text-green-600">
                                        <span>Discount:</span>
                                        <span class="font-medium">-₹<%= discount.toFixed(2) %></span>
                                    </div>
                                    <% } %>
                                    
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Shipping:</span>
                                        <span class="font-medium">₹<%= shippingCharge.toFixed(2) %></span>
                                    </div>
                                    
                                    <%
                                        // Calculate tax on discounted amount
                                        let taxableAmount = subtotal - discount;
                                        taxAmount = taxableAmount * taxRate;
                                    %>
                                    
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Tax (GST <%= (taxRate * 100).toFixed(0) %>%):</span>
                                        <span class="font-medium">₹<%= taxAmount.toFixed(2) %></span>
                                    </div>
                                    
                                    <div class="border-t border-gray-200 pt-3 mt-3">
                                        <div class="flex justify-between text-xl font-bold">
                                            <span class="text-hardware-primary">Grand Total:</span>
                                            <%
                                                grandTotal = taxableAmount + shippingCharge + taxAmount;
                                            %>
                                            <span class="text-hardware-primary">₹<%= grandTotal.toFixed(2) %></span>
                                        </div>
                                        <p class="text-right text-sm text-gray-500 mt-1">
                                            <% if(order.paymentMethod === 'COD') { %>
                                                (Cash on Delivery)
                                            <% } else { %>
                                                (Paid via <%= order.paymentMethod || 'Online Payment' %>)
                                            <% } %>
                                        </p>
                                    </div>

                                   
                                </div>
                            </div>
                        </div>
                    </div>
                    
                <% } else { %>
                    <div class="text-center py-8">
                        <i class="fas fa-shopping-bag text-gray-300 text-4xl mb-4"></i>
                        <p class="text-gray-500">No items in this order</p>
                    </div>
                <% } %>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap gap-3 mb-8 no-print">
                <% if(order.status === "Processing") { %>
                    <button onclick="cancelOrder()" class="inline-flex items-center px-5 py-3 bg-red-50 hover:bg-red-100 text-red-700 font-medium rounded-lg transition-colors">
                        <i class="fas fa-times-circle mr-2"></i> Cancel Order
                    </button>
                <% } %>
                
                <% if(order.status === "Delivered") { %>
                    <button onclick="downloadInvoice()" class="inline-flex items-center px-5 py-3 bg-green-50 hover:bg-green-100 text-green-700 font-medium rounded-lg transition-colors">
                        <i class="fas fa-download mr-2"></i> Download Invoice PDF
                    </button>
                    <button onclick="requestReturn()" class="inline-flex items-center px-5 py-3 border border-hardware-primary text-hardware-primary hover:bg-hardware-primary hover:text-white font-medium rounded-lg transition-colors">
                        <i class="fas fa-undo mr-2"></i> Request Return/Exchange
                    </button>
                <% } %>
                
                <button onclick="printInvoice()" class="inline-flex items-center px-5 py-3 bg-hardware-primary hover:bg-hardware-secondary text-white font-medium rounded-lg transition-colors">
                    <i class="fas fa-print mr-2"></i> Print Invoice
                </button>
                
                <a href="/product" class="inline-flex items-center px-5 py-3 bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium rounded-lg transition-colors">
                    <i class="fas fa-shopping-cart mr-2"></i> Continue Shopping
                </a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-hardware-primary text-white py-8 px-4 lg:px-8 no-print">
        <div class="container mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-6 md:mb-0 text-center md:text-left">
                    <h3 class="text-xl font-bold mb-2">JOY Hardware Products</h3>
                    <p class="text-gray-300">Quality tools for professionals and DIY enthusiasts</p>
                </div>
                <div class="text-center md:text-right">
                    <p class="mb-2">
                        <i class="fas fa-envelope mr-2"></i>
                        sales@joyhardware.com
                    </p>
                    <p>
                        <i class="fas fa-phone mr-2"></i>
                        +91 XXXXXXXXXX
                    </p>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-6 text-center text-gray-300">
                <p>&copy; 2023 JOY Hardware Solutions. All Rights Reserved.</p>
                <p class="text-sm mt-1">GST No: 27AAECJ1234M1Z5 | PAN No: AAECJ1234M</p>
            </div>
        </div>
    </footer>

    <script src="/script/customer/Order-details.js"></script>
</body>
</html>