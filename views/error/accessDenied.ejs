<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - JOY Hardware Solutions</title>
    <link rel="stylesheet" href="/css/error/accessDenied.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="error-container">
        <div class="error-content">
            <!-- Animated 403 Number -->
            <div class="error-code">
                <span class="digit">4</span>
                <span class="digit">0</span>
                <span class="digit">3</span>
            </div>
            
            <!-- Error Message -->
            <div class="error-message">
                <i class="fas fa-lock"></i>
                <h1>Access Denied!</h1>
                <p>You don't have permission to access this page. Please login or contact your administrator.</p>
            </div>
            
            <!-- Action Buttons -->
            <div class="action-buttons">
                <a href="/" class="home-btn">
                    <i class="fas fa-arrow-left"></i> Back to Homepage
                </a>
            </div>
            
            <!-- Help Text -->
            <p class="help-text">
                Need assistance? <a href="/contact">Contact our support team</a>
            </p>
        </div>
    </div>
    
    <script src="/script/error/accessDenied.js"></script>
</body>
</html>