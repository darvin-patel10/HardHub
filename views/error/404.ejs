<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - JOY Hardware Solutions</title>
    <link rel="stylesheet" href="/css/error/404.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="error-container">
        <div class="error-content">
            <!-- Animated 404 Number -->
            <div class="error-code">
                <span class="digit">4</span>
                <span class="digit">0</span>
                <span class="digit">4</span>
            </div>
            
            <!-- Error Message -->
            <div class="error-message">
                <i class="fas fa-tools"></i>
                <h1>Oops! <%= message || 'Page Not Found' %></h1>
                <!-- <p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p> -->
            </div>
            
            <!-- Back to Home Button -->
            <a href="/" class="home-btn">
                <i class="fas fa-arrow-left"></i> Back to Homepage
            </a>
            
            <!-- Help Text -->
            <p class="help-text">
                Need assistance? <a href="/contact">Contact our support team</a>
            </p>
        </div>
    </div>
    
    <script src="/script/error/404.js"></script>
</body>
</html>