<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products - JOY Hardware</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/Admin/Products-list.css">
</head>
<body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-blue-800 text-white p-4 shadow-md">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold">JOY Hardware Seller Portal</h1>
            <div class="flex items-center space-x-4">
                <span class="text-sm">Welcome, <%= seller.username %></span>
                <form id="logoutForm" action="/auth/logout" method="POST" style="display: inline;">
                    <button type="submit" class="bg-red-500 hover:bg-red-600 px-3 py-1 rounded text-sm">Logout</button>
                </form>
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="bg-gray-200 p-2 shadow-sm">
        <div class="container mx-auto flex space-x-4">
            <a href="/seller" class="px-3 py-1 rounded hover:bg-gray-300">Dashboard</a>
            <a href="/seller/products" class="px-3 py-1 rounded bg-blue-100 text-blue-800 font-medium">Products</a>
            <a href="/seller/product/new" class="px-3 py-1 rounded hover:bg-gray-300">Add Product</a>
            <a href="/seller/orders" class="px-3 py-1 rounded hover:bg-gray-300">Orders</a>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mx-auto p-4">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Product Inventory</h1>
            <a href="/seller/product/new" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                Add Product
            </a>
        </div>

        <!-- Search and Filter -->
        <div class="bg-white p-4 rounded-lg shadow-md mb-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex-1">
                    <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search Products</label>
                    <div class="relative">
                        <input type="text" id="search" placeholder="Search by name or SKU..." 
                               class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <button class="absolute right-3 top-2 text-gray-400 hover:text-gray-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div>
                    <label for="category" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                    <select id="category" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="all" >All Categories</option>
                        <% 
                        let allCategories = new Set();
                        allproducts.forEach(product => {
                            if (product.category) {
                                allCategories.add(product.category);
                            }
                        });
                        allCategories.forEach(category => { %>
                            <option value="<%=category%>"><%=category%></option>
                        <% }); %>
                    </select>
                </div>
                
                <div class="mb-4 mt-4 flex-col justify-between items-center">

                    <div class="flex-col space-x-2">
                        <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Size </label>

                        <select id="sizeFilter" class="px-3 py-2 border rounded">
                            <option value="all">All Sizes</option>
                            <% 
                            let allSizes = new Set();
                            allproducts.forEach(product => {
                                if(product.sizes) {
                                    product.sizes.forEach(size => allSizes.add(size.size));
                                }
                            });
                            allSizes.forEach(size => { %>
                                <option value="<%=size%>">Size <%=size%></option>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <div>
                    <label for="stock" class="block text-sm font-medium text-gray-700 mb-1">Stock Status</label>
                    <select id="stock" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">All</option>
                        <option value="low">Low Stock</option>
                        <option value="out">Out of Stock</option>
                        <option value="in">In Stock</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Products Table -->
<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-100">
                <tr>
                    <th class="text-left p-3">Product</th>
                    <th class="text-left p-3">SKU</th>
                    <th class="text-left p-3">Price</th>
                    <th class="text-left p-3">Size</th>
                    <th class="text-left p-3">Stock</th>
                    <th class="text-left p-3">Category</th>
                    <th class="text-left p-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for (let product of allproducts) {%>
                    <% let defaultSize = product?.sizes && product?.sizes[0]; %>
                    <% let defaultStock = defaultSize ? defaultSize.stock : (product?.stock || 0); %>
                    <tr class="border-b hover:bg-gray-50 product-row"
                        data-product-id="<%=product._id%>"
                        data-category="<%=product?.category || ''%>"
                        data-stock="<%=defaultStock%>"
                        data-sizes="<%=(product?.sizes || []).map(size => size.size).join(',')%>">
                        <td class="p-3 flex items-center">
                            <img src="<%=product.image[0]?.url%>" 
                                alt="<%=product.name%>" class="w-12 h-12 object-cover rounded mr-3">
                            <div>
                                <h3 class="font-medium"><%=product?.name%></h3>
                                <p class="text-gray-500 text-sm"><%=product?.small_description%></p>
                            </div>
                        </td>
                        <td class="p-3"><%=product?.productid%></td>
                        
                        <!-- Dynamic Price based on selected size -->
                        <td class="p-3 price-display">
                            ₹<%=product.sizes[0]?.price || product?.price || 0%>
                        </td>
                        
                        <!-- Size Dropdown -->
                        <td class="p-3">
                            <select class="size-selector px-2 py-1 border rounded text-sm" 
                                    data-product-id="<%=product?._id%>"
                                    onchange="updateProductDetails(this)">
                                <% if(product.sizes && product.sizes.length > 0) { %>
                                    <% product?.sizes.forEach((size, index) => { %>
                                        <option value="<%=index%>" 
                                                data-size="<%=size?.size%>"
                                                data-price="<%=size?.price%>" 
                                                data-stock="<%=size?.stock%>">
                                            <%=size?.size%> 
                                            <% if(size.price !== product.sizes[0]?.price) { %>
                                                (₹<%=size?.price%>)
                                            <% } %>
                                        </option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="0" data-size="Default" data-price="<%=product?.price%>" data-stock="<%=product?.stock%>">
                                        Default
                                    </option>
                                <% } %>
                            </select>
                        </td>
                        
                        <!-- Dynamic Stock Status -->
                        <td class="p-3 stock-display">
                            <% let stock = defaultStock; %>
                            
                            <% if(stock < 5 && stock > 0) { %>
                                <span class="px-2 py-1 rounded text-sm bg-yellow-100 text-yellow-700">
                                    <%=stock%> Low stock
                                </span>
                            <% } else if(stock === 0) { %>
                                <span class="px-2 py-1 rounded text-sm bg-red-100 text-red-700">
                                    Out of stock
                                </span>
                            <% } else { %>
                                <span class="px-2 py-1 rounded text-sm bg-green-100 text-green-700">
                                    <%=stock%> In stock
                                </span>
                            <% } %>
                        </td>
                        
                        <td class="p-3"><%=product?.category%></td>
                        <td class="p-3">
                            <div class="flex space-x-2">
                                <a href="/seller/product/edit/<%=product._id%>" class="text-blue-600 hover:text-blue-800">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                    </svg>
                                </a>
                                <form action="/seller/product/delete/<%=product._id%>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    <button type="submit">    
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600 hover:text-red-800" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                </form>    
                            </div>
                        </td>
                    </tr>
                <%}%>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="p-4 border-t flex justify-between items-center">
        <div class="text-sm text-gray-600">
            Showing 1 to <%=allproducts?.length%> of <%=allproducts?.length%> products
        </div>
        <div class="flex space-x-1">
            <button class="px-3 py-1 border rounded bg-gray-100 text-gray-600">&laquo;</button>
            <button class="px-3 py-1 border rounded bg-blue-600 text-white">1</button>
            <button class="px-3 py-1 border rounded hover:bg-gray-100">2</button>
            <button class="px-3 py-1 border rounded hover:bg-gray-100">3</button>
            <button class="px-3 py-1 border rounded hover:bg-gray-100">&raquo;</button>
        </div>
    </div>
</div>
    </main>

    <script src="/script/Admin/Products-list.js"></script>
</body>
</html>
